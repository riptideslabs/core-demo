# cp .env.example .env  — .env is untracked.

# Act 3 injects this into the client's outbound requests to api.github.com.
# A token with NO scopes is enough: GET /user only needs to authenticate.
GITHUB_PAT=

# Optional overrides. Both are resolved automatically by lib/preflight.sh —
# set them only if that fails (e.g. several daemons share this host's name).
# DAEMON_WORKLOAD_ID=riptides/daemon/00000000-0000-0000-0000-000000000000
# TRUST_DOMAIN=example.console.riptides.io

# ── which box the demo drives ────────────────────────────────────────────────
# lima (default): a local Lima VM, sharing this directory as a writable mount.
# ssh:            any joined Linux box — EC2, bare metal, a VM elsewhere. The
#                 demo directory is copied there, and the PAT below is NOT sent.
# DEMO_TARGET=lima

# lima only — which VM. Default: default
# LIMA_VM=default

# ssh only — where to reach the box, and where to put the demo on it.
# SSH_DEST=ec2-user@203.0.113.10
# SSH_KEY=~/.ssh/demo.pem
# REMOTE_DIR=riptides-demo          # relative paths resolve against $HOME there

# The daemon's Prometheus endpoint, if it has one. A daemon installed by the docs
# installer exports over OTLP to the control plane and serves no local /metrics,
# in which case act 3 says so rather than showing an empty grep.
# METRICS_URL=http://localhost:50601/metrics
